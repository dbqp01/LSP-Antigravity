{
  "lsp-enforcement-kit": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name",
        "hooks": [
          {
            "type": "command",
            "command": "python nav_guard.py pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python lsp_audit.py post-tool",
            "timeout": 15
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python lsp_audit.py pre-invocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python lsp_audit.py stop",
        "timeout": 5
      }
    ]
  }
}
